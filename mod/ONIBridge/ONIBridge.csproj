<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <AssemblyName>ONIBridge</AssemblyName>
    <RootNamespace>ONIBridge</RootNamespace>
    <!-- Game DLLs are in lib/ — copy from ONI install on Ubuntu -->
    <GameFolder Condition="'$(GameFolder)' == ''">$(HOME)/.steam/steam/steamapps/common/OxygenNotIncluded/OxygenNotIncluded_Data/Managed</GameFolder>
    <ModFolder Condition="'$(ModFolder)' == ''">$(HOME)/.config/unity3d/Klei/Oxygen Not Included/mods/dev/ONIBridge</ModFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- Game assemblies — never copy-local, must exist in lib/ -->
    <Reference Include="Assembly-CSharp">
      <HintPath>lib/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>lib/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>lib/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>lib/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Build-time only — provides net471 targeting pack without Visual Studio -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net471" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <!-- Harmony reference for IntelliSense — game provides the actual DLL -->
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Auto-deploy to mod dev folder after build (Linux only) -->
  <Target Name="Deploy" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <MakeDir Directories="$(ModFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModFolder)" />
    <Copy SourceFiles="$(ProjectDir)mod_info.yaml" DestinationFolder="$(ModFolder)" />
  </Target>

</Project>
